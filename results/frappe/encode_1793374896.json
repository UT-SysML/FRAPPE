        "decode_latents"
      ],
      "source": "\"\"\"hybrid_zstd_imagecodecs v2 with optimized int8\u2194uint8 conversions.\n\nSame logic as hybrid_zstd_imagecodecs.py but the int8\u2192uint8 dance for\nthe imagecodecs JPEG-LS path uses ``view + add`` (uint8 wrap-around)\ninstead of going through int16. Microbenchmark on (768, 256): 200 \u03bcs \u2192\n5 \u03bcs (40\u00d7) per scale conversion.\n\nThe shift is `+127 (mod 256)` matching the existing pillow_jpls path\n(int8 [-127, 127] \u2194 uint8 [0, 254]).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport struct\nimport sys\nfrom pathlib import Path\n\nimport imagecodecs\nimport numpy as np\nimport torch\nimport zstandard as zstd\n\nsys.path.insert(0, str(Path(__file__).parent))\nfrom _common import (  # noqa: E402\n    ArrangedLatents,\n    arrange_latents_per_scale_2d,\n    pack_chunks,\n    roundtrip_check,\n    unarrange_latents_per_scale_2d,\n    unpack_chunks,\n)\n\n\n_ZSTD_LEVEL = 3\n_ZSTD_THRESHOLD_NUMEL = 1024\n\n_C = zstd.ZstdCompressor(level=_ZSTD_LEVEL)\n_D = zstd.ZstdDecompressor()\n\n_TAG_ZSTD = 0\n_TAG_JPEGLS = 1\n\n_SHIFT_FWD = np.uint8(127)\n_SHIFT_BWD = np.uint8(129)  # = -127 mod 256, undoes the +127 wrap\n\n\ndef arrange_latents(latents):\n    return arrange_latents_per_scale_2d(latents)\n\n\ndef unarrange_latents(arranged, scale_groups):\n    return unarrange_latents_per_scale_2d(arranged, scale_groups)\n\n\ndef encode_latents(arranged):\n    chunks = []\n    for z_2d in arranged:\n        if z_2d.numel() <= _ZSTD_THRESHOLD_NUMEL:\n            rows, cols = z_2d.shape\n            b = z_2d.contiguous().numpy().tobytes()\n            comp = _C.compress(b)\n            chunks.append(bytes([_TAG_ZSTD]) + struct.pack(\">II\", rows, cols) + comp)\n        else:\n            arr = z_2d.contiguous().numpy()\n            u8 = arr.view(np.uint8) + _SHIFT_FWD  # view-then-add, uint8 wrap\n            comp = imagecodecs.jpegls_encode(u8)\n            chunks.append(bytes([_TAG_JPEGLS]) + comp)\n    return pack_chunks(chunks)\n\n\ndef decode_latents(blob):\n    arranged = []\n    for chunk in unpack_chunks(blob):\n        tag = chunk[0]\n        body = chunk[1:]\n        if tag == _TAG_ZSTD:\n            rows, cols = struct.unpack_from(\">II\", body, 0)\n            raw = _D.decompress(body[8:])\n            t = torch.frombuffer(bytearray(raw), dtype=torch.int8).reshape(rows, cols)\n            arranged.append(t.clone())\n        elif tag == _TAG_JPEGLS:\n            u8 = imagecodecs.jpegls_decode(body)\n            if u8.ndim != 2:\n                u8 = u8.reshape(u8.shape[0], -1)\n            i8 = (u8 + _SHIFT_BWD).view(np.int8)  # inverse wrap\n            arranged.append(torch.from_numpy(i8).clone())\n        else:\n            raise ValueError(f\"Unknown chunk tag {tag}\")\n    return arranged\n\n\nif __name__ == \"__main__\":\n    n_bytes = roundtrip_check(sys.modules[__name__])\n    print(f\"hybrid_v2 round-trip OK ({n_bytes} bytes)\")\n"
    }
  },
